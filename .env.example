# Copy to .env (never commit .env). For EAS builds set the same names as EAS environment variables.
# Local dev (supabase start prints these values):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# OpenFreeMap style (no key needed)
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

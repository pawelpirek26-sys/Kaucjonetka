{
  "expo": {
    "name": "Kaucjomat",
    "slug": "kaucjomat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kaucjomat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "pl.kaucjomat.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pl.kaucjomat.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kaucjomat używa lokalizacji, żeby przypisać kupon do najbliższego sklepu, pokazać punkty zwrotu w pobliżu i potwierdzić, że zgłoszenie awarii pochodzi sprzed automatu.",
          "locationAlwaysAndWhenInUsePermission": "Jeśli włączysz przypomnienia przy sklepie, Kaucjomat w tle sprawdza tylko, czy wchodzisz do sklepu, w którym masz kupony. Twoja lokalizacja nie jest nigdzie wysyłana.",
          "locationAlwaysPermission": "Jeśli włączysz przypomnienia przy sklepie, Kaucjomat w tle sprawdza tylko, czy wchodzisz do sklepu, w którym masz kupony. Twoja lokalizacja nie jest nigdzie wysyłana.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kaucjomat używa aparatu do fotografowania kuponów kaucyjnych i odczytu kodu kreskowego.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true,
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {}
    }
  }
}

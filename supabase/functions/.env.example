# Local Edge Function env (copy to supabase/functions/.env). In the cloud use
# `supabase secrets set OSM_IMPORT_SECRET=...` (OVERPASS_URL is optional:
# comma-separated list tried in order; default overpass-api.de, then overpass.private.coffee).
OSM_IMPORT_SECRET=change-me
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
